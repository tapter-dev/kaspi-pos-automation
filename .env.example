TOKEN_SECRET_KEY=
PORT=3000
DATABASE_URL=postgres://kaspi_app:kaspi-app-local-only@localhost:55432/kaspi_automation
DATABASE_MIGRATION_URL=postgres://kaspi_admin:kaspi-admin-local-only@localhost:55432/kaspi_automation
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
TRUST_PROXY=false
DATA_DIR=./data
# Optional for hosts where API and worker cannot share DATA_DIR. Generate once
# and inject the same base64-encoded JSON values into both services.
KASPI_KEYPAIR_JSON_BASE64=
KASPI_DEVICE_JSON_BASE64=
# Migration-only password used to create/update the restricted kaspi_app role.
DATABASE_RUNTIME_PASSWORD=
# Generate independently from TOKEN_SECRET_KEY: openssl rand -hex 32
API_KEY_PEPPER=
# Generate independently: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
ALLOW_SIGNUPS=true
# Disabled by default when DATABASE_URL is set; enable only for demo compatibility.
ENABLE_LEGACY_API=false
# Optional for contract tests or an approved Kaspi gateway proxy
# KASPI_ENTRANCE_URL=https://entrance-pay.kaspi.kz
# KASPI_MTOKEN_URL=https://mtoken.kaspi.kz
# KASPI_QRPAY_URL=https://qrpay.kaspi.kz
REQUEST_LOGS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=kaspi-automation

# ─── App version & device constants (optional) ───
# Defaults match a known-good Kaspi Pay client.
# ⚠️ The Kaspi API validates these — use values from a real device cookie.
# KASPI_APP_VERSION=4.112.1
# KASPI_APP_BUILD=1107
# KASPI_APP_PLATFORM=iOS
# KASPI_APP_PLATFORM_VER=18.4
# KASPI_APP_LOCALE=ru-RU
# KASPI_APP_MODEL=iPhone16,2
# KASPI_APP_BRAND=Apple
# KASPI_APP_DEVICE_NAME=iPhone
# KASPI_APP_SCREEN_W=430.0
# KASPI_APP_SCREEN_H=932.0
# KASPI_APP_CFNETWORK=CFNetwork/3826.400.120
# KASPI_APP_DARWIN=Darwin/24.4.0
